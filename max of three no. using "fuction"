def max_of_three(a, b, c):
    if a >= b and a >= c: # agar a , b aur c dono se bada hai to a return kar do
        return a
    elif b >= a and b >= c: # agar b , a aur c dono se bada hai to b return kar do
        return b
    else:
        return c # agar upar ke dono conditions false hai to c hi maximum hoga to c return kar do

# main program
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

print("The maximum number is:", max_of_three(a, b, c))
