#if else elif statement
# == equal to
# != not equal to
# > greater than
# < less than
# >= greater than or equal to
# <= less than or equal to  


a = int(input("enter your age here: "))
 
if (a <= 0): 
    print("Invalid age.")

elif (a < 18):
    print("You are not eligible to vote.")

elif (a == 18):
    print("You are now eligible to vote.")

else:
    print("You are eligible to vote.")
