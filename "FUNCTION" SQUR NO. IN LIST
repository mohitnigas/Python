def square_list():
    squares = []  # empty list
    numbers = []  # empty list
    for i in range(1, 31):
        squares.append(i * i)
        numbers.append(i) # add square of each number to list
    print(squares,numbers,sep="   baccha hame door hona padega   ") # print the list of squares

# main program
square_list() #yahi run karta hai function ko
