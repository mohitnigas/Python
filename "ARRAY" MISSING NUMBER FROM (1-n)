#Here we find the missing number from the list.

array = list(map(int, input("Enter numbers separated by spaces: ").split()))    #first it read that input must be integer then, it split them by comma then, form list of those numbers
n = len(array) + 1
total_sum = n * (n + 1) // 2
array_sum = sum(array)
missing = total_sum - array_sum
print("Missing number is:", missing)


