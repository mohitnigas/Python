#3 IT GIVES INCRIMENT IN SALARY OF EMPLOYEE
class employee :
    salary = 50000
    incriment = 20

    @property
    def salaryAfterincirment (self):
        return print(f"salay after incriment will be {self.salary + self.salary*(self.incriment/100)}")
    
    @salaryAfterincirment.setter
    def salaryAfterincirment(self,salary):
        self.incriment = ((salary/self.salary)-1)*100

e = employee()
print(e.salaryAfterincirment)
e.salaryAfterincirment = 60000
