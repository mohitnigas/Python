#train class to get all the info realted to train
import random
class train :
    def __init__(self,trainNO):
        self.trainNO = trainNO
        
    def book (self,fro,to):
        print(f"Ticket is booked in train no {self.trainNO} from {fro} to {to}")
    
    def getstatus(self):
         print(f"train no. {self.trainNO} running on time from departure")
        
    def getfare (self,fro,to):
        print(f"the fare of {self.trainNO} from {fro} to {to} is {random.randint(0,100)}")

t = train(3102006)
t.book("bihar","champara")
t.getstatus()
t.getfare("bihar","champara")
